<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" prefWidth="360.0" prefHeight="300.0"
      xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controllers.LoginController">
    <children>
        <Label text="Login" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <TextField fx:id="usernameField" promptText="Username" />
        <PasswordField fx:id="passwordField" promptText="Password" />
        <Button text="Log In" onAction="#handleLogin" maxWidth="Infinity" defaultButton="true" />
        <Label fx:id="errorLabel" style="-fx-text-fill: red;" />
        <Button fx:id="homeButton" text="Switch to Home View" onAction="#switchToHome" />
    </children>
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
</VBox>