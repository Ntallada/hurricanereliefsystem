<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="850.0" prefWidth="390.0" spacing="20.0" styleClass="login-root" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <StackPane prefHeight="260.0" prefWidth="200.0" styleClass="header">
         <children>
            <Label styleClass="brand" text="GPP Relief" />
         </children>
      </StackPane>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="8.0">
         <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
         </padding>
         <children>
            <Label styleClass="title" text="Welcome Back." />
            <Label styleClass="subtitle" text="Sign in to continue" />
            <Label styleClass="field-label" text="Email Address" />
            <TextField fx:id="txt_username" promptText="you@example.com" styleClass="input" />
            <Label styleClass="field-label" text="Password" />
            <PasswordField fx:id="txt_password" promptText="Password" styleClass="input" />
            <CheckBox mnemonicParsing="false" styleClass="small-text" text="Remember me" />
            <Button fx:id="btn_login" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#login" text="Log In" />
            <Hyperlink styleClass="link" text="New to GPP Relief? Create an account" />
         </children>
      </VBox>
   </children>
</VBox>
