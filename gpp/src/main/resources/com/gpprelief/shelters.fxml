<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="812.0" prefWidth="375.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="12.0">
         <padding>
            <Insets left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="menuButton" mnemonicParsing="false" text="Menu" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="GPP Relief" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="notificationsButton" mnemonicParsing="false" text="Alerts" />
         </children>
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
         <content>
            <VBox spacing="16.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
               </padding>
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Find a shelter" />
                        <Label text="A safer place, closer to you." />
                     </children>
                  </VBox>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="searchField" promptText="Search city or ZIP code" HBox.hgrow="ALWAYS" />
                        <Button fx:id="filterButton" mnemonicParsing="false" text="Filter" />
                     </children>
                  </HBox>

                  <VBox spacing="6.0">
                     <children>
                        <Pane fx:id="mapContainer" prefHeight="180.0">
                           <children>
                              <Label layoutX="24.0" layoutY="24.0" text="Oak Park" />
                              <StackPane layoutX="115.0" layoutY="72.0">
                                 <children>
                                    <Circle radius="13.0" />
                                    <Label text="1" />
                                 </children>
                              </StackPane>
                              <StackPane layoutX="218.0" layoutY="24.0">
                                 <children>
                                    <Circle radius="13.0" />
                                    <Label text="2" />
                                 </children>
                              </StackPane>
                              <Label fx:id="selectedMapPinLabel" layoutX="16.0" layoutY="146.0" text="1 Community Center" />
                              <VBox layoutX="292.0" layoutY="88.0" spacing="4.0">
                                 <children>
                                    <Button fx:id="zoomInButton" mnemonicParsing="false" text="+" />
                                    <Button fx:id="zoomOutButton" mnemonicParsing="false" text="-" />
                                 </children>
                              </VBox>
                           </children>
                        </Pane>
                        <Label text="Illustrative map - sample locations" />
                     </children>
                  </VBox>

                  <VBox spacing="2.0">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Nearby shelters" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label fx:id="resultsCountLabel" text="2 results" />
                           </children>
                        </HBox>
                        <Label text="Sample listings - availability is not live" />
                     </children>
                  </VBox>

                  <VBox fx:id="shelterListContainer" spacing="12.0">
                     <children>
                        <VBox spacing="10.0">
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label text="1" />
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <HBox alignment="CENTER_LEFT">
                                             <children>
                                                <Label text="Community Center" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="1.2 mi" />
                                             </children>
                                          </HBox>
                                          <Label text="Meals - Accessible entrance" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label text="Emergency shelter" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="shelter1DetailsButton" mnemonicParsing="false" text="View details" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <VBox spacing="10.0">
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label text="2" />
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <HBox alignment="CENTER_LEFT">
                                             <children>
                                                <Label text="Northside High School" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="2.4 mi" />
                                             </children>
                                          </HBox>
                                          <Label text="Family area - Pet-friendly" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label text="Emergency shelter" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="shelter2DetailsButton" mnemonicParsing="false" text="View details" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <Label text="Confirm shelter status before traveling." />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>

   <bottom>
      <HBox alignment="CENTER" prefHeight="60.0" spacing="8.0">
         <children>
            <Button fx:id="navHomeButton" maxWidth="Infinity" mnemonicParsing="false" text="Home" HBox.hgrow="ALWAYS" />
            <Button fx:id="navRequestsButton" maxWidth="Infinity" mnemonicParsing="false" text="Requests" HBox.hgrow="ALWAYS" />
            <Button fx:id="navSheltersButton" maxWidth="Infinity" mnemonicParsing="false" text="Shelters" HBox.hgrow="ALWAYS" />
            <Button fx:id="navAccountButton" maxWidth="Infinity" mnemonicParsing="false" text="Account" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </bottom>
</BorderPane>